{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfile": "./Dockerfile",
    "watchPatterns": [
      "./backend/**/*",
      "./Dockerfile",
      "./.env.railway",
      "./railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python manage.py collectstatic --noinput && gunicorn backend.wsgi:application --bind 0.0.0.0:$PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/admin/",
    "healthcheckTimeout": 10
  }
} 