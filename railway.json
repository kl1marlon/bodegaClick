{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "backend",
      "path": "./backend",
      "envs": {
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "DEBUG": "False",
        "ALLOWED_HOSTS": ".railway.app,backend-production-a8d3.up.railway.app,*"
      }
    },
    {
      "name": "frontend",
      "path": "./frontend",
      "envs": {
        "REACT_APP_API_URL": "${{backend.RAILWAY_PUBLIC_URL}}",
        "BACKEND_URL": "${{backend.RAILWAY_PUBLIC_URL}}"
      },
      "persistent_folders": [],
      "depends_on": ["backend"],
      "healthcheck": {
        "path": "/config.js",
        "interval": 10,
        "timeout": 5
      }
    }
  ]
} 