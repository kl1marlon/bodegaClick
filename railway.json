{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfile": "./Dockerfile",
    "watchPatterns": [
      "./backend/**/*",
      "./Dockerfile",
      "./.env.railway",
      "./railway.json"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:8000 --log-level debug --access-logfile - --error-logfile -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/admin/",
    "healthcheckTimeout": 10
  }
} 